# Local development defaults. Copy this file to .env before starting Uvicorn.
HOIKUICT_ENV=development
HOIKUICT_ENABLE_MOCK_AUTH=1
HOIKUICT_KIOSK_ACCESS_MODE=open
HOIKUICT_CSRF_ENFORCE=0
# Optional override for the packaged public-demo baseline database.
DEMO_TEMPLATE_DB_PATH=./demo_data/demo-template.sqlite3
HOIKUICT_PUSH_TRANSPORT=capture
# webpushを選ぶ場合だけ、development専用の鍵と公開originを設定する。
# HOIKUICT_PUSH_VAPID_PUBLIC_KEY=
# HOIKUICT_PUSH_VAPID_PRIVATE_KEY=
# HOIKUICT_PUSH_VAPID_SUBJECT=mailto:developer@example.com
# HOIKUICT_PUBLIC_ORIGIN=https://localhost:8000

# Public demo deployment (configure in Dockge; never commit real secrets).
# PUBLIC_DEMO_MODE=1
# HOIKUICT_ENV=production
# HOIKUICT_COOKIE_SECURE=1
# HOIKUICT_CSRF_ENFORCE=1
# HOIKUICT_SECRET_KEY=
# HOIKUICT_ALLOWED_ORIGINS=https://demo.hoikuict.net
# HOIKUICT_PUSH_TRANSPORT=webpush
# HOIKUICT_PUSH_VAPID_PUBLIC_KEY=
# HOIKUICT_PUSH_VAPID_PRIVATE_KEY=
# HOIKUICT_PUSH_VAPID_SUBJECT=mailto:developer@example.com
# HOIKUICT_PUBLIC_ORIGIN=https://demo.hoikuict.net

# Development only: anonymized review corpus (opened read-only).
HOIKU_DAILY_PLAN_EXAMPLES_DB_PATH=../hoiku-plan-corpus/work/anonymized-review.sqlite

# Daily reflection reminder shown to the plan owner after this local time.
HOIKU_DAILY_REFLECTION_REMINDER_TIME=16:30
