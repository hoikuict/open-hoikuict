# 認証版βの設定例。実際の値は .env.beta.local に保存し、Gitへ登録しない。
HOIKUICT_ENV=development
HOIKUICT_ENABLE_MOCK_AUTH=0
HOIKUICT_STAFF_AUTH_MODE=local_password
HOIKUICT_PARENT_AUTH_MODE=local_password
HOIKUICT_LOGIN_THROTTLE_HMAC_KEY=32バイト以上の固定値へ変更
HOIKUICT_SECRET_KEY=32文字以上の固定値へ変更
HOIKUICT_DATABASE_URL=sqlite:///./hoikuict-beta-auth.db
HOIKUICT_CSRF_ENFORCE=1
HOIKUICT_COOKIE_SECURE=0
HOIKUICT_KIOSK_ACCESS_MODE=disabled
HOIKUICT_PUSH_TRANSPORT=disabled
HOIKUICT_PARENT_MAIL_TRANSPORT=capture
HOIKUICT_PARENT_REGISTRATION_BASE_URL=http://127.0.0.1:8001
# 管理者のメール再設定も上のURL・メール設定を共用する。
# 職員用URLを分ける場合だけ指定する（本番はHTTPS）。
# HOIKUICT_STAFF_RECOVERY_BASE_URL=https://staff.example.jp
# リバースプロキシ配下だけ設定する。* は使わず、プロキシの送信元IP/CIDRに限定する。
# FORWARDED_ALLOW_IPS=127.0.0.1
# 保護者招待・管理者の再設定メールを実送信する環境では smtp と到達可能なHTTPS URLを設定する。
# HOIKUICT_PARENT_MAIL_TRANSPORT=smtp
# HOIKUICT_PARENT_REGISTRATION_BASE_URL=https://hoiku.example.jp
# HOIKUICT_SMTP_HOST=mail.example.local
# HOIKUICT_SMTP_PORT=587
# HOIKUICT_SMTP_STARTTLS=1
# HOIKUICT_SMTP_USERNAME=
# HOIKUICT_SMTP_PASSWORD=
# HOIKUICT_PARENT_MAIL_FROM=noreply@example.jp
